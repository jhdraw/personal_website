# Copy to .env.local for local dev; set the same vars on Vercel for production.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Comma-separated Google accounts that can access /admin.
# MUST match the list in supabase/schema.sql -> is_owner().
NEXT_PUBLIC_OWNER_EMAILS=jqianhuii@gmail.com,zhengxianyap@gmail.com

# Optional: the public hostname. On Vercel the production *.vercel.app domain is
# detected automatically; only set this for a custom domain.
# NEXT_PUBLIC_SITE_HOST=

# Spotify (developer.spotify.com -> your app). Get the refresh token via:
#   node scripts/spotify-token.mjs
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# GIPHY (developers.giphy.com -> create an app -> API key). Used only by the
# admin-gated /api/giphy search in the Q&A admin panel; visitors load published
# GIFs straight from GIPHY's CDN, so no key is exposed to the browser.
GIPHY_API_KEY=

# Cloudflare R2 (file storage). Secrets stay server-side; only the public URL is exposed.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=qianhui-personal-website
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
